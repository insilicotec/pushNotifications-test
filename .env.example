# Variáveis de Ambiente — Web Push Notifications
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no Git

# ── Chaves VAPID (geradas com: npx web-push generate-vapid-keys) ──────────────
VAPID_PUBLIC_KEY=SUA_CHAVE_PUBLICA_AQUI
VAPID_PRIVATE_KEY=SUA_CHAVE_PRIVADA_AQUI
VAPID_MAILTO=mailto:seu@email.com

# ── Upstash Redis (obtidas no dashboard Vercel → Integrations → Upstash) ──────
UPSTASH_REDIS_REST_URL=https://SEU_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=SEU_TOKEN_AQUI
